{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/free",
  "permission": {
    "read": {
      "*": "allow",
      "~/.local/share/opencode/auth.json": "deny",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "edit": {
      "*": "allow",
      "~/.local/share/opencode/auth.json": "deny",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "bash": {
      "*": "allow",
      "*auth.json*": "deny",
      "*OPENROUTER_API_KEY*": "deny",
      "*GROQ_API_KEY*": "deny",
      "*GOOGLE_API_KEY*": "deny",
      "*MISTRAL_API_KEY*": "deny",
      "*CEREBRAS_API_KEY*": "deny"
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Local",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.5:9b": {
          "name": "Qwen 3.5 9B Local",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  },
  "agent": {
    "doc_agent": {
      "model": "openrouter/mistralai/mistral-nemo",
      "mode": "subagent",
      "description": "Génération de documentation et commentaires"
    },
    "coder_agent": {
      "model": "openrouter/inclusionai/ling-3.0-flash-vl",
      "mode": "primary",
      "description": "Écriture de fonctions et refactoring classique"
    },
    "architect_agent": {
      "model": "openrouter/openai/gpt-5.6-luna",
      "mode": "subagent",
      "description": "Résolution de bugs complexes et conception système"
    }
  }
}