{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/free",
  "permission": {
    "read": {
      "*": "allow",
      "~/.local/share/opencode/auth.json": "deny",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "edit": {
      "*": "allow",
      "~/.local/share/opencode/auth.json": "deny",
      "*.env": "deny",
      "*.env.*": "deny"
    },
    "bash": {
      "*": "allow",
      "*auth.json*": "deny",
      "*OPENROUTER_API_KEY*": "deny",
      "*GROQ_API_KEY*": "deny",
      "*GOOGLE_API_KEY*": "deny",
      "*MISTRAL_API_KEY*": "deny",
      "*CEREBRAS_API_KEY*": "deny"
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Local",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.5:9b": {
          "name": "Qwen 3.5 9B Local",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  },
  "agent": {
    "build": {
      "model": "openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
      "mode": "primary",
      "description": "Agent de développement principal : écriture de code, refactoring et exécution de commandes"
    },
    "plan": {
      "model": "openrouter/qwen/qwen3.5-35b-a3b",
      "mode": "primary",
      "description": "Agent d'architecture et de cadrage : analyse et élaboration de plans sans modification directe"
    },
    "explore": {
      "model": "openrouter/google/lyria-3-clip-preview",
      "mode": "subagent",
      "description": "Sous-agent d'exploration rapide : recherche de fichiers et lecture du codebase en lecture seule"
    },
    "general": {
      "model": "openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
      "mode": "subagent",
      "description": "Sous-agent polyvalent : exécution de tâches déléguées et recherches complexes"
    }
  }
}